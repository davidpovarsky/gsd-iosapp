    },
    "Erasing removes all tasks, Saved items, archived items, the Trash, custom views, pins, and your feedback draft, and resets archive settings. If you're signed in, it also deletes your synced tasks, so they're gone from your other devices too. Your appearance, notification, and sharing settings are kept. Export first if you want a backup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erasing removes all tasks, Saved items, archived items, the Trash, custom views, pins, and your feedback draft, and resets archive settings. If you're signed in, it also deletes your synced tasks, so they're gone from your other devices too. Your appearance, notification, and sharing settings are kept. Export first if you want a backup."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל המשימות, הפריטים השמורים, הארכיון, סל המיחזור, התצוגות המותאמות, ההצמדות וטיוטת המשוב יימחקו. הגדרות הארכיון יאופסו. בחשבון מחובר יימחקו גם המשימות שסונכרנו בכל המכשירים. הגדרות המראה, ההתראות והשיתוף יישמרו. לגיבוי כדאי לייצא תחילה."
          }
        }
      },
      "extractionState": "manual"
    },
