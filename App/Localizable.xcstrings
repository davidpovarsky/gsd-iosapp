    "Off by default. When enabled, GSD contacts the shared page to fetch a readable title. Only links you share are requested.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. When enabled, GSD contacts the shared page to fetch a readable title. Only links you share are requested."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבוי כברירת מחדל. כשהאפשרות מופעלת, GSD טוען את כותרת הדף רק עבור קישורים שבחרת לשתף."
          }
        }
      },
      "extractionState": "manual"
    },
    "On Mac, Trash has a right-click menu to restore or delete a task.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Mac, Trash has a right-click menu to restore or delete a task."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב־Mac אפשר ללחוץ בכפתור הימני בסל המיחזור כדי לשחזר משימה או למחוק אותה."
          }
        }
      },
      "extractionState": "manual"
    },
    "On a 13-inch iPad in landscape, each quadrant now shows two columns of tasks with the sidebar open. Before, the Columns button did nothing there.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a 13-inch iPad in landscape, each quadrant now shows two columns of tasks with the sidebar open. Before, the Columns button did nothing there."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב־iPad בגודל 13 אינץ׳ במצב אופקי אפשר להציג שתי עמודות משימות בכל רבע גם כשסרגל הצד פתוח. בעבר הכפתור „עמודות” לא השפיע במצב הזה."
          }
        }
      },
      "extractionState": "manual"
    },
    "On iPad and Mac, a quadrant with a single task no longer stretches that card to fill the space.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPad and Mac, a quadrant with a single task no longer stretches that card to fill the space."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב־iPad וב־Mac כרטיס בודד ברבע שומר על גודלו."
          }
        }
      },
      "extractionState": "manual"
    },
    "On iPad and Mac, drag a card onto another quadrant. On iPhone, open the ⋯ menu and choose Move to.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPad and Mac, drag a card onto another quadrant. On iPhone, open the ⋯ menu and choose Move to."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב־iPad וב־Mac גוררים כרטיס לרבע אחר. ב־iPhone בוחרים „העברה אל” בתפריט ⋯."
          }
        }
      },
      "extractionState": "manual"
    },
    "On iPad and Mac, each quadrant lays its tasks out in columns when the window has room, so more of your list fits on screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPad and Mac, each quadrant lays its tasks out in columns when the window has room, so more of your list fits on screen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשיש די מקום בחלון, המשימות בכל רבע מסודרות בעמודות כדי להציג יותר מהן על המסך."
          }
        }
      },
      "extractionState": "manual"
    },
    "On iPad and Mac, wide windows show tasks in columns.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPad and Mac, wide windows show tasks in columns."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחלון רחב ב־iPad וב־Mac אפשר להציג משימות בעמודות."
          }
        }
      },
      "extractionState": "manual"
    },
    "On iPhone and iPad, swipe right to complete. Swipe left to snooze for an hour or delete, or to Mark urgent when a task is escalating.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPhone and iPad, swipe toward the end of the row to complete. Swipe toward the start to snooze for an hour, delete, or mark an escalating task urgent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב־iPhone וב־iPad מחליקים מסוף השורה לתחילתה כדי לדחות בשעה, למחוק או לסמן כדחופה כשהדחיפות עולה. החלקה בכיוון ההפוך משלימה את המשימה."
          }
        }
      },
      "extractionState": "manual"
    },
    "Onboarding's urgency arrow points at the urgent column.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Onboarding's urgency arrow points at the urgent column."
