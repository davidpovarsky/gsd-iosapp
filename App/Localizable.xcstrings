    "GSD couldn't open its local storage. Your data hasn't been deleted. Please quit and reopen the app. If this keeps happening, free up some storage space, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GSD couldn't open its local storage. Your data hasn't been deleted. Please quit and reopen the app. If this keeps happening, free up some storage space, then try again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתיחת האחסון המקומי של GSD נכשלה. הנתונים שלך נשמרו. כדאי לצאת מהיישום ולפתוח אותו מחדש. אם הבעיה נמשכת, יש לפנות מקום במכשיר ולנסות שוב."
          }
        }
      },
      "extractionState": "manual"
    },
    "GSD has an Apple Watch app. Today and Do First open on your wrist, and a swipe completes a task.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GSD has an Apple Watch app. Today and Do First open on your wrist, and a swipe completes a task."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביישום GSD ל־Apple Watch אפשר לפתוח את „היום” ואת „לביצוע מיידי” מפרק היד ולהשלים משימה בהחלקה."
          }
        }
      },
      "extractionState": "manual"
    },
    "GSD on Apple Watch, your top three for today, and a weekly sweep.": {
      "localizations": {
