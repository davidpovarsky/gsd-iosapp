      "extractionState": "manual"
    },
    "Tasks you share from Safari or other apps reach your other devices right away instead of waiting until you open GSD.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks you share from Safari or other apps reach your other devices right away instead of waiting until you open GSD."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משימות שמשתפים מ־Safari או מיישומים אחרים מגיעות מיד לשאר המכשירים, עוד לפני פתיחת GSD."
          }
        }
      },
      "extractionState": "manual"
    },
    "That task is no longer available.": {
