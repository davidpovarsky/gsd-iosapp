          }
        }
      },
      "extractionState": "manual"
    },
    "A task can have at most 50 subtasks.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task can have at most 50 subtasks."
          }
        },
