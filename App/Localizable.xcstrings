          }
        }
      },
      "extractionState": "manual"
    },
    "Your four quadrants are your home view: a 2×2 grid on iPad and Mac, four stacked sections on iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your four quadrants are your home view: a 2×2 grid on iPad and Mac, four stacked sections on iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ארבעת הרבעים הם מסך הבית שלך. ב־iPad וב־Mac הם מוצגים ברשת של שתיים על שתיים, וב־iPhone הם מוצגים זה מתחת לזה."
          }
        }
      },
      "extractionState": "manual"
    },
    "Your picks show first in the Today's Focus widget and on Apple Watch. They sync to your other devices only when you're signed in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your picks show first in the Today's Focus widget and on Apple Watch. They sync to your other devices only when you're signed in."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבחירות שלך מופיעות ראשונות ביישומון „המיקוד להיום” וב־Apple Watch. הן מסתנכרנות עם שאר המכשירים רק בחשבון מחובר."
          }
        }
      },
      "extractionState": "manual"
    },
    "Your session expired — sign in again to keep syncing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session expired — sign in again to keep syncing."
