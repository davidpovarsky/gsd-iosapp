          "stringUnit": {
            "state": "translated",
            "value": "אין צורך לשתף עם הגשר את מסד הנתונים של GSD, את חשבון Apple או מפתחות API."
          }
        }
      },
      "extractionState": "manual"
    },
    "You signed in as %@, but this device has tasks from a previous account. Keep them and sync them to this account, or start fresh?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You signed in as %@, but this device has tasks from a previous account. Keep them and sync them to this account, or start fresh?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחברת עם %@, ובמכשיר יש משימות מחשבון קודם. לשמור אותן ולסנכרן עם החשבון הזה או להתחיל מחדש?"
          }
        }
      },
      "extractionState": "manual"
    },
    "You're all caught up.": {
      "localizations": {
