          }
        }
      },
      "extractionState": "manual"
    },
    "A task couldn't be archived. Please try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task couldn't be archived. Please try again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העברת המשימה לארכיון נכשלה. כדאי לנסות שוב."
          }
        }
      },
      "extractionState": "manual"
    },
    "A task that isn't urgent can show as escalating as its due date gets close. Pick the window in Settings, or turn it off. Nothing moves until you choose Mark urgent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task that isn't urgent can show as escalating as its due date gets close. Pick the window in Settings, or turn it off. Nothing moves until you choose Mark urgent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשמועד היעד מתקרב, משימה שאינה דחופה יכולה לקבל סימון „הדחיפות עולה”. בהגדרות אפשר לבחור את פרק הזמן או לכבות את הסימון. המשימה תעבור רבע רק לאחר בחירה ב„סימון כדחופה”."
          }
        }
      },
      "extractionState": "manual"
    },
    "A task you delete while signed out no longer disappears from your other devices after you sign in. If your account still has it, it comes back here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task you delete while signed out no longer disappears from your other devices after you sign in. If your account still has it, it comes back here."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משימה שנמחקה בזמן ניתוק מהחשבון תישאר במכשירים האחרים לאחר ההתחברות. אם היא עדיין בחשבון, היא תחזור גם לכאן."
          }
        }
      },
      "extractionState": "manual"
    },
    "A timed task reminds you before its due time, and all-day tasks remind you at 9 a.m. Each reminder has Complete and Snooze 1 hour buttons. When Quiet Hours is on in Settings › Notifications, reminders wait until the quiet window ends.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A timed task reminds you before its due time, and all-day tasks remind you at 9 a.m. Each reminder has Complete and Snooze 1 hour buttons. When Quiet Hours is on in Settings › Notifications, reminders wait until the quiet window ends."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למשימה עם שעה תתקבל תזכורת לפני המועד. למשימה של יום שלם התזכורת תתקבל ב־9 בבוקר. מהתזכורת אפשר לסמן השלמה או לדחות בשעה. בשעות השקטות התזכורות ממתינות עד סוף החלון שהוגדר."
          }
        }
      },
      "extractionState": "manual"
    },
