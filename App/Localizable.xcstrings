    },
    "A calm place to sort what's urgent and important — and let go of what isn't.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm place to sort what's urgent and important — and let go of what isn't."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקום שקט להבחין בין דחוף לחשוב, ולוותר על מה שאינו נחוץ."
          }
        }
      },
      "extractionState": "manual"
    },
    "A few minutes to clear what’s gone quiet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few minutes to clear what’s gone quiet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה דקות לעבור על משימות שנשארו בצד."
          }
        }
      },
      "extractionState": "manual"
    },
    "A large Today's Focus widget.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A large Today's Focus widget."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישומון גדול של „המיקוד להיום”."
          }
        }
      },
      "extractionState": "manual"
    },
    "A number beside the sync icon counts changes waiting to upload. An amber icon needs attention, like being offline or a session that expired; tap it to open Settings and see why. A red icon means the last sync failed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A number beside the sync icon counts changes waiting to upload. An amber icon needs attention, like being offline or a session that expired; tap it to open Settings and see why. A red icon means the last sync failed."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המספר ליד סמל הסנכרון מציין כמה שינויים ממתינים להעלאה. צבע ענברי מציין מצב שדורש תשומת לב, למשל חיבור חסר או שפג תוקפו. נגיעה בסמל פותחת את ההגדרות עם הסיבה. אדום מציין שהסנכרון האחרון נכשל."
          }
        }
      },
      "extractionState": "manual"
    },
    "A previous operation may have committed. Reconcile it in the original context before retrying.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous operation may have committed. Reconcile it in the original context before retrying."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שהפעולה הקודמת כבר בוצעה. יש לבדוק את תוצאתה לפני ניסיון נוסף."
          }
        }
      }
    },
    "A refreshed look built for iOS 27 and macOS 27.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refreshed look built for iOS 27 and macOS 27."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מראה מעודכן ל־iOS 27 ול־macOS 27."
          }
        }
      },
      "extractionState": "manual"
    },
    "A single shared quadrant for a partner or teammate, still local-first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single shared quadrant for a partner or teammate, still local-first."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רבע משותף עם בן משפחה או עמית, כשהנתונים עדיין נשמרים קודם במכשיר."
          }
        }
      },
      "extractionState": "manual"
    },
    "A task can depend on at most 50 tasks.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task can depend on at most 50 tasks."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משימה יכולה להיות תלויה בעד 50 משימות."
          }
        }
      },
      "extractionState": "manual"
    },
    "A task can have at most 20 tags.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task can have at most 20 tags."
          }
        },
        "he": {
