    "Saved holds reading and reference outside the matrix, with short notes, and syncs with the web and Android apps.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved holds reading and reference outside the matrix, with short notes, and syncs with the web and Android apps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב„שמורים” אפשר לשמור חומרי קריאה ומידע עם הערות קצרות מחוץ למטריצה ולסנכרן אותם עם יישומי הרשת ו־Android."
          }
        }
      },
      "extractionState": "manual"
    },
    "Saved items don't show in the matrix, smart views, or the dashboard, and they don't send reminders. Find Saved in Browse on iPhone, or under Library on iPad and Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved items don't show in the matrix, smart views, or the dashboard, and they don't send reminders. Find Saved in Browse on iPhone, or under Library on iPad and Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריטים שמורים אינם מופיעים במטריצה, בתצוגות החכמות ובלוח הבקרה, ואינם שולחים תזכורות. ב־iPhone הם נמצאים ב„עיון”, וב־iPad וב־Mac תחת „ספרייה”."
          }
        }
      },
      "extractionState": "manual"
    },
    "Saved keeps a task out of the matrix until you're ready for it, like an article to read or an idea. Choose Move to Saved from a task's ⋯ menu. Add notes, then choose Return to matrix to make it an active task again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved keeps a task out of the matrix until you're ready for it, like an article to read or an idea. Choose Move to Saved from a task's ⋯ menu. Add notes, then choose Return to matrix to make it an active task again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להעביר משימה ל„שמורים” מתפריט ⋯ כדי לשמור מאמר, רעיון או משימה להמשך. אפשר להוסיף הערות ולבחור „החזרה למטריצה” כשהגיע הזמן לטפל בה."
          }
        }
      },
      "extractionState": "manual"
    },
