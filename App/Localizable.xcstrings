    "The API key is saved only in your device Keychain. An API provider may charge for usage. This is not ChatGPT account sign-in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API key is saved only in your device Keychain. An API provider may charge for usage. This is not ChatGPT account sign-in."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפתח ה־API נשמר רק בצרור המפתחות של המכשיר. ספק המודל עשוי לגבות תשלום על השימוש. ההתחברות לחשבון ChatGPT נפרדת."
          }
        }
      },
      "extractionState": "manual"
    },
