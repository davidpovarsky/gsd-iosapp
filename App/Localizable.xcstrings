    "After an update with something new, one line under the capture bar tells you what changed. Dismiss it and it stays gone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After an update with something new, one line under the capture bar tells you what changed. Dismiss it and it stays gone."
          }
