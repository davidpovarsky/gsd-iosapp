    "Merge keeps your current tasks and Saved items and adds the imported ones. Replace deletes your current tasks and Saved items first — and, if you're signed in, deletes them on all your devices.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge keeps your current tasks and Saved items and adds the imported ones. Replace deletes your current tasks and Saved items first — and, if you're signed in, deletes them on all your devices."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מיזוג שומר את המשימות והפריטים השמורים ומוסיף אליהם את הפריטים מהקובץ. החלפה מוחקת תחילה את המשימות והפריטים השמורים הקיימים, ובחשבון מחובר גם בכל המכשירים."
          }
        }
      },
      "extractionState": "manual"
    },
    "Minutes": {
      "localizations": {
        "en": {
          "stringUnit": {
