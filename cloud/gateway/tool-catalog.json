  {
    "name": "list_tasks",
    "title": "List tasks",
    "description": "Search and filter active GSD tasks",
    "writes": false,
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": [
            "all",
            "open",
            "completed"
          ]
        },
        "quadrant": {
          "type": "string",
          "enum": [
            "do_first",
            "schedule",
            "delegate",
            "eliminate"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
