[Unit]
Description=Consistent GSD PocketBase and OAuth backup
After=gsd-pocketbase.service gsd-cloud-gateway.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
UMask=0077
ExecStart=/usr/bin/python3 /mnt/development/projects/gsd-cloud/backup.py
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# SQLite read-only online backups may create/open WAL shared-memory sidecars.
ReadWritePaths=/mnt/development/projects/gsd-cloud/backups /mnt/development/projects/gsd-cloud/pb_data
ReadOnlyPaths=/mnt/development/projects/gsd-cloud
